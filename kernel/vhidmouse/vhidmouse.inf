; vhidmouse.inf - installs the VHF virtual mouse as a root-enumerated device.
;
; Two install paths:
;   * test signing / BYOVD: point Windows at the .sys directly (see README)
;   * attestation signing: get the .sys attested by Microsoft, then ship this INF
;
; Manual install (admin):
;   devcon.exe update vhidmouse.inf Root\VhidMouse
;   or: pnputil /add-driver vhidmouse.inf /install

[Version]
Signature   = "$Windows NT$"
Class       = Mouse
ClassGuid   = {4d36e96f-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
CatalogFile = vhidmouse.cat
DriverVer   = 06/01/2026,1.0.0.0
PnpLockdown = 1

[Manufacturer]
%ProviderName% = VhidMouse, NTamd64

[VhidMouse.NTamd64]
%DeviceName% = VhidMouse_Install, Root\VhidMouse

[VhidMouse_Install]
; VHF devices are not backed by real hardware; no resource requirements.

[VhidMouse_Install.Services]
AddService = vhidmouse, 0x00000002, VhidMouse_Service

[VhidMouse_Service]
DisplayName    = %ServiceName%
ServiceType    = 1                  ; kernel-mode driver
StartType      = 3                  ; demand start
ErrorControl   = 1
ServiceBinary  = %12%\vhidmouse.sys

[Strings]
ProviderName = "VhidMouse"
DeviceName   = "Vhid Virtual Mouse"
ServiceName  = "vhidmouse"
