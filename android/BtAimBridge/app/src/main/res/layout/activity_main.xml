<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BtAimBridge"
            android:textSize="26sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Turn this phone into a Bluetooth mouse for ValAim"
            android:textSize="13sp"
            android:alpha="0.7"
            android:paddingBottom="24dp" />

        <TextView
            android:id="@+id/tvIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PC IP: ..."
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:paddingBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Type this IP into the aim tool on the PC"
            android:textSize="12sp"
            android:alpha="0.6"
            android:paddingBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TCP port"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etPort"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:inputType="number"
                android:text="47800"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnRefresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Refresh" />
        </LinearLayout>

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="START"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnLock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="锁定: ON (点这里开关)" />

        <Button
            android:id="@+id/btnFireSnap"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="🎯 锁头开枪"
            android:textSize="20sp"
            android:textStyle="bold"
            android:backgroundTint="#b91c1c" />

        <Button
            android:id="@+id/btnMouseProxy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="鼠标代理 (推荐: 竖屏中转+左键拦截)" />

        <Button
            android:id="@+id/btnMouseTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="鼠标代理测试 (读鼠标事件)" />

        <Button
            android:id="@+id/btnDiscover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Make discoverable (for pairing)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btBtSettings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="蓝牙设置(取消配对)" />

            <Button
                android:id="@+id/btnResetHid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="重置HID注册" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Idle"
            android:textSize="15sp"
            android:paddingTop="24dp"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TOUCHPAD - drag here to move the PC cursor"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <View
            android:id="@+id/touchpad"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:background="#22000000" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:alpha="0.7"
            android:paddingTop="16dp"
            android:text="If dragging here moves the PC cursor, the Bluetooth HID link works.&#10;&#10;Then on the PC run:&#10;ValAim.exe --input-backend bt --bt-host &lt;the IP above&gt;&#10;&#10;Keep this screen open." />

    </LinearLayout>
</ScrollView>
